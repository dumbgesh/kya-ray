# Kya-Ray Cloud Backend Environment Configuration
# Copy this file to .env and provide your API keys

# GroqCloud API Key (keep this private on backend only)
GROQ_API_KEY=your_groq_api_key_here

# GroqCloud Model Selection (e.g. qwen/qwen3.8-27b, openai/gpt-oss-120b)
GROQ_MODEL=qwen/qwen3.8-27b

# Server configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_ENVIRONMENT=development

